# Copy to .env and fill in. .env is gitignored.

# LLM key, used only by discovery runs. Replay never calls a model.
ANTHROPIC_API_KEY=

# ParaBank operator credentials, used only by the session provider.
# They are never sent to the model and never written to logs or artifacts.
PARABANK_USERNAME=
PARABANK_PASSWORD=

# Host port for the local ParaBank container (`make parabank-up`). The
# parabank-local tenant URL follows it. Change it where 8080 is already taken.
PARABANK_PORT=8080
