            "stability": "medium",
            "templated": false,
            "value": "select#type",
            "verified": {
              "run_id": "handwritten-m2",
              "same_element": true,
              "unique": true
            }
          }
        ]
      },
      "timeout_ms": 10000,
      "value": {
        "param": "account_type"
      }
    },
    {
      "action": "select",
      "effect": "input",
      "expect": [
