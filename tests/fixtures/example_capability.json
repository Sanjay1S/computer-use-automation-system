{
  "app": {
    "compatible_versions": [
      "3.*"
    ],
    "entry_route": "/openaccount.htm",
    "surface": "web",
    "vendor_app": "parabank"
  },
  "description": "Opens a new CHECKING or SAVINGS account for the signed-in ParaBank customer, funded by transferring the minimum opening deposit from one of their existing accounts, and returns the new account's id. The funding account must belong to the signed-in customer.",
  "id": "parabank.open_account",
  "inputs": [
    {
      "description": "The kind of account to open.",
      "enum": [
        "CHECKING",
        "SAVINGS"
      ],
      "example": "SAVINGS",
      "name": "account_type",
      "required": true,
      "sensitivity": "public",
      "type": "enum"
    },
    {
      "description": "The existing account the opening deposit comes from. Must be one of the signed-in customer's own accounts.",
      "example": "12345",
      "name": "funding_account_id",
      "pattern": "^\\d+$",
      "required": true,
      "sensitivity": "financial_id",
      "type": "string"
    }
  ],
  "lifecycle": {
    "status": "draft"
  },
  "outcomes": [
    {
      "code": "funding_account_not_found",
      "description": "The funding account list loaded, but it does not contain the requested account: it is not one of this customer's accounts. Nothing was committed.",
      "detected_by": "s3_funding_account",
      "terminal": true
    }
  ],
  "outputs": [
    {
      "description": "The id of the account that was opened.",
      "name": "new_account_id",
      "pattern": "^\\d+$",
      "sensitivity": "financial_id",
      "source_step": "s5_read_new_id",
      "type": "string"
    }
  ],
  "provenance": {
    "authored": "hand_written",
    "discovery_run_id": "handwritten-m2",
    "goal_template": "Open a new {account_type} account funded from {funding_account_id}",
    "human_steps": [],
    "locator_stats": {
      "locators": 5,
      "targets": 4,
      "verified_unique": 5
    },
    "models_served": [],
    "recorded_against": "parabank-local"
  },
  "recovery": {
    "allowed": [
      "retry_transient",
      "reauthenticate",
      "dismiss_interstitial"
    ],
    "budget": 3
  },
  "requires": {
    "secrets": [],
    "session": "parabank.customer"
  },
  "schema_version": "understudy.capability/v1",
  "side_effects": {
    "approval": "per_invocation",
    "class": "commit",
    "description": "Creates a real account and moves the minimum opening deposit out of the funding account. Running it twice opens two accounts.",
    "idempotent": false
  },
  "steps": [
    {
      "action": "navigate",
      "effect": "read",
