        ],
        "max_attempts": 2
      },
      "target": {
        "description": "The new account id on the confirmation panel",
        "fingerprint": {
          "tag": "a"
        },
        "frame_path": [],
        "locators": [
          {
            "by": "css",
            "note": "The only element on the page carrying the id; recon read one from it.",
            "stability": "high",
            "templated": false,
            "value": "#newAccountId",
            "verified": {
              "run_id": "handwritten-m2",
              "same_element": true,
              "unique": true
            }
          }
        ]
