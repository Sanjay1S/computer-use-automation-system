      "reentry_point": false,
      "retry": {
        "backoff_ms": [],
        "max_attempts": 0
      },
      "target": {
        "description": "The funding account dropdown, AJAX-loaded after page load",
        "fingerprint": {
          "role": "combobox",
          "tag": "select"
        },
        "frame_path": [],
        "locators": [
          {
            "by": "css",
            "note": "Hand-written JSP id; the AJAX handler targets it by this id too, so the id cannot drift without the page's own script breaking.",
            "stability": "medium",
            "templated": false,
            "value": "select#fromAccountId",
