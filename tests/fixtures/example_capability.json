      "wait_before": {
        "kind": "options_loaded",
        "min": 1,
        "target": "select#fromAccountId"
      }
    },
    {
      "action": "click",
      "effect": "commit",
      "expect": [
        {
          "description": "The account was opened",
          "then": {
            "do": "continue"
          },
          "when": {
            "exact": true,
            "kind": "visible",
            "text": "Account Opened!"
          }
        },
        {
          "description": "The app errored after the click. The deposit may or may not have moved, so this goes to a human rather than to a retry.",
          "then": {
            "code": "app_error_after_commit",
            "do": "escalate"
          },
          "when": {
            "exact": true,
            "kind": "visible",
            "text": "An internal error has occurred and has been logged."
          }
        }
      ],
      "id": "s4_submit",
      "intent": "Submit the form. This opens the account and moves the deposit.",
      "reentry_point": false,
      "retry": {
        "backoff_ms": [],
        "max_attempts": 0
      },
      "target": {
        "description": "The 'Open New Account' submit button. The left-hand nav has a link of exactly the same name, so role is what separates them.",
        "fingerprint": {
          "name": "Open New Account",
          "role": "button"
        },
        "frame_path": [],
        "locators": [
          {
            "by": "role",
            "note": "Role+name is unique: recon confirmed the heading, the nav link and this button all read 'Open New Account', and only role tells them apart. A name-only or text locator would match three elements and is therefore not offered as a fallback.",
            "stability": "high",
            "templated": false,
            "value": {
              "exact": true,
              "name": "Open New Account",
              "role": "button"
            },
            "verified": {
              "run_id": "handwritten-m2",
              "same_element": true,
              "unique": true
            }
          },
          {
            "by": "css",
            "note": "The value attribute is the button's label; it moves with it.",
            "stability": "medium",
            "templated": false,
            "value": "input[type='button'][value='Open New Account']",
            "verified": {
              "run_id": "handwritten-m2",
              "same_element": true,
              "unique": true
            }
          }
        ]
      },
      "timeout_ms": 30000
    },
    {
      "action": "extract",
      "effect": "read",
      "expect": [
        {
          "description": "A numeric account id is present",
          "then": {
            "do": "succeed"
          },
          "when": {
            "css": "#newAccountId",
            "exact": true,
            "kind": "visible"
          }
        }
      ],
      "extract": {
        "output": "new_account_id",
        "parse": "regex",
        "read": "text",
        "regex": "^\\s*(\\d+)\\s*$"
      },
      "id": "s5_read_new_id",
      "intent": "Read the new account id off the confirmation panel",
      "reentry_point": false,
      "retry": {
        "backoff_ms": [
