                "exact": true,
                "kind": "visible",
                "name": "Open New Account",
                "role": "heading"
              }
            ],
            "kind": "all"
          }
        }
      ],
      "id": "s1_open_form",
      "intent": "Go to the account opening form",
      "reentry_point": true,
      "retry": {
        "backoff_ms": [
          500,
          1000
        ],
        "max_attempts": 2
      },
      "timeout_ms": 15000,
      "url": "{base_url}/openaccount.htm"
    },
    {
      "action": "select",
      "effect": "input",
      "expect": [
        {
          "description": "The dropdown holds the requested type",
          "then": {
            "do": "continue"
          },
          "when": {
            "kind": "selected",
            "param": "account_type",
            "target": "select#type"
          }
        }
      ],
      "id": "s2_account_type",
      "intent": "Choose the account type",
      "reentry_point": false,
